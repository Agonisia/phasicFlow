/* ------------------------------------------------------------------------- */  
objectName 	geometryDict;
objectType 	dictionary;
fileFormat  ASCII;
/*---------------------------------------------------------------------------*/

// 运动模型：绕轴旋转
motionModel rotatingAxis;										

rotatingAxisInfo                            // 运动参数信息
{
	rotAxis 																	// 旋转轴定义
	{
		p1 (0.0 0.0 0.0);	                     	// 旋转轴的第一个点（起点） 

		p2 (0.0 0.0 1.0);	                     	// 旋转轴的第二个点（终点）

		omega      1.214; 		                 	// 旋转角速度 (rad/s)
	}
}

surfaces
{
	/*
		半径为0.12m的圆柱体，轴线从(0 0 0)到(0 0 0.1)
	*/
	cylinder
	{
		type cylinderWall;                      // 壁面类型：圆柱壁

		p1  (0.0 0.0 0.0);                      // 圆柱轴起点

		p2  (0.0 0.0 0.1);                      // 圆柱轴终点

		radius1      0.12;		                 	// 起点处半径 [m]

		radius2      0.12;		                 	// 终点处半径 [m]

		resolution     24;                      // 网格分辨率（周向分段数）

		material    prop1;                      // 壁面材料名称

		motion    rotAxis;		                 	// 运动组件名称
	}

	/*
		圆柱体后端（底部）的平面壁
	*/
	wall1
	{
		type       planeWall;			         			// 壁面类型：平面壁

		p1 (-0.12 -0.12 0.0);	                 	// 平面第一个角点

		p2 ( 0.12 -0.12 0.0);                   // 平面第二个角点

		p3 ( 0.12  0.12 0.0);                   // 平面第三个角点

		p4 (-0.12  0.12 0.0);                   // 平面第四个角点 

		material       prop1;                   // 壁面材料名称

		motion       rotAxis;										// 运动组件名称
	}

	/*
		圆柱体前端（顶部）的平面壁
	*/
	wall2
	{
		type       planeWall;                    // 壁面类型：平面壁

		p1 (-0.12 -0.12 0.1);                    // 平面第一个角点

		p2 ( 0.12 -0.12 0.1);                    // 平面第二个角点

		p3 ( 0.12  0.12 0.1);                    // 平面第三个角点

		p4 (-0.12  0.12 0.1);                    // 平面第四个角点

		material       prop1;                    // 壁面材料名称

		motion       rotAxis;                    // 运动组件名称
	}
}

